{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug zipper.exe with MinGW64 GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/zipper.exe",
            "args": ["t.txt", "t.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/x86_64-15.2.0-release-posix-seh-ucrt-rt_v13-rev0/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}